{
  "logo": "/nl2120_logo.png",
  "initialSetup": {},
  "legendStack": "horizontal",
  "infoDialog": {
    "enabled": true,
    "showOnStart": true,
    "showButton": true,
    "remember": "local",
    "title": "Over deze kaart",
    "contentFile": "info-dialog.md",
    "closeLabel": "Sluiten",
    "width": "50vw",
    "height": "70vh"
  },
  "steps": [
    {
      "id": "layerViewer",
      "title": "Layers",
      "drawerTitle": "Map layers",
      "requiresConfirmation": false,
      "components": [
        {
          "component": "LayerList",
          "componentProps": {
            "layers": [
              {
                "id": "fysischgeografischeregios",
                "name": "Landschapstypen",
                "active": true,
                "clickable": false
              },
              {
                "id": "longlist_1_1:1_1_longlist",
                "name": "NbS locaties",
                "active": true,
                "clickable": true,
                "attributeFilter": {
                  "title": "Filter landschapstype en NbS",
                  "attributeKey": "landschap_filter",
                  "secondaryAttributeKey": "nbs_prio",
                  "defaultCollapse": true,
                  "delimiter": ";",
                  "wfsUrl": "https://nl2120.openearth.nl/geoserver/wfs?service=WFS&version=2.0.0&request=GetFeature&typeNames=longlist_1_1:1_1_longlist&outputFormat=application/json"
                },
                "featureInfo": {
                  "title": "Locatie-informatie",
                  "emptyValue": "—",
                  "fields": [
                    {
                      "attribute": "naam",
                      "title": "Naam"
                    },
                    {
                      "attribute": "landschapscluster",
                      "title": "Landschapstypen"
                    },
                    {
                      "attribute": "omschrijving",
                      "title": "Omschrijving"
                    },
                    {
                      "attribute": "casus_nl2120",
                      "title": "Toegevoegde waarde voor NL2120"
                    },
                    {
                      "attribute": "url",
                      "title": "Meer weten?"
                    },
                    {
                      "attribute": "link_art",
                      "title": "Uitgewerkte leercasus (indien aanwezig)"
                    }
                  ]
                },
                "relatedGeometry": {
                  "layerId": "longlist_1_1:longlist_nl2120_gebieden",
                  "outlineLayerId": "longlist_1_1:longlist_nl2120_gebieden_outline",
                  "sourceAttribute": "fid",
                  "targetAttribute": "fid",
                  "fitBounds": true,
                  "showOnHover": true,
                  "showOnHoverWithSelection": true
                }
              }
            ]
          }
        }
      ]
    }
  ]
}